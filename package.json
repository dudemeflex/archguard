{
  "name": "archguard",
  "version": "0.1.0",
  "description": "Enforce repository architecture rules across Git changes and complete revisions",
  "main": "dist/src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dudemeflex/archguard.git"
  },
  "homepage": "https://github.com/dudemeflex/archguard#readme",
  "bugs": {
    "url": "https://github.com/dudemeflex/archguard/issues"
  },
  "bin": {
    "archguard": "dist/src/index.js"
  },
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:action": "ncc build src/action/index.ts -o action-dist --minify --transpile-only --no-source-map-register",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build && npm run build:action",
    "test": "vitest --run",
    "lint": "eslint \"src/**/*.{ts,js}\" \"test/**/*.{ts,js}\" --max-warnings=0",
    "prepack": "npm run build"
  },
  "keywords": [
    "architecture",
    "dependency",
    "github-actions",
    "pull-request",
    "typescript",
    "javascript",
    "static-analysis",
    "ci",
    "sarif",
    "scanner",
    "cli"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "js-yaml": "^4.1.0",
    "picomatch": "^2.3.2",
    "typescript": "^5.6.2",
    "yargs": "^17.7.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.5.6",
    "@types/picomatch": "^2.3.3",
    "@types/yargs": "^17.0.18",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "vitest": "^3.2.7"
  }
}
